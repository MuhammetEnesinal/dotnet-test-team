{
  "schemaVersion": 1,
  "description": "Database engines the plugin can start as a throw-away Docker container for a test run. Loaded and validated strictly by scripts/dtt/core/dbengines.py (unknown keys are rejected). Image repositories are official ones; a project's compose file can only choose a tag, and only for a repository listed in composeRepos. {password} is never put on a command line: it is passed through the docker client's own environment (docker run -e NAME), and inside the container only as an environment variable assignment in front of a command or in a here-doc body (never as a program argument). Engines with recipe false are only recognised.",
  "engines": [
    {
      "id": "sqlserver",
      "recipe": true,
      "packagePatterns": ["microsoft.entityframeworkcore.sqlserver"],
      "image": "mcr.microsoft.com/mssql/server",
      "composeRepos": ["mcr.microsoft.com/mssql/server"],
      "defaultTag": "2022-latest",
      "port": 1433,
      "memoryMb": 2048,
      "needsEula": true,
      "eulaUrl": "https://go.microsoft.com/fwlink/?linkid=857698",
      "archs": ["amd64"],
      "pullSizeHintMb": 1600,
      "passwordEnv": "MSSQL_SA_PASSWORD",
      "env": ["ACCEPT_EULA=Y", "MSSQL_PID=Developer", "MSSQL_SA_PASSWORD={password}"],
      "exec": ["/bin/sh", "-c", "for t in /opt/mssql-tools18/bin/sqlcmd /opt/mssql-tools/bin/sqlcmd; do if [ -x \"$t\" ]; then SQLCMDPASSWORD=\"$MSSQL_SA_PASSWORD\" exec \"$t\" -C -S 127.0.0.1 -U sa -b -Q 'SELECT 1'; fi; done; exit 1"],
      "readyTimeoutS": 120,
      "connection": "Server=127.0.0.1,{port};User Id=sa;Password={password};TrustServerCertificate=True;Encrypt=False",
      "adminDatabase": "master"
    },
    {
      "id": "postgres",
      "recipe": true,
      "packagePatterns": ["npgsql.entityframeworkcore.postgresql"],
      "image": "postgres",
      "composeRepos": ["postgres"],
      "defaultTag": "16-alpine",
      "port": 5432,
      "memoryMb": 512,
      "needsEula": false,
      "archs": ["amd64", "arm64"],
      "pullSizeHintMb": 100,
      "passwordEnv": "POSTGRES_PASSWORD",
      "env": ["POSTGRES_PASSWORD={password}"],
      "exec": ["/bin/sh", "-c", "PGPASSWORD=\"$POSTGRES_PASSWORD\" exec psql -h 127.0.0.1 -U postgres -d postgres -tAc 'SELECT 1'"],
      "readyTimeoutS": 60,
      "connection": "Host=127.0.0.1;Port={port};Username=postgres;Password={password};Database=postgres",
      "adminDatabase": "postgres"
    },
    {
      "id": "mysql",
      "recipe": true,
      "packagePatterns": ["pomelo.entityframeworkcore.mysql", "mysql.entityframeworkcore"],
      "image": "mysql",
      "composeRepos": ["mysql"],
      "defaultTag": "8.4",
      "port": 3306,
      "memoryMb": 1024,
      "needsEula": false,
      "archs": ["amd64", "arm64"],
      "pullSizeHintMb": 600,
      "passwordEnv": "MYSQL_ROOT_PASSWORD",
      "env": ["MYSQL_ROOT_PASSWORD={password}"],
      "exec": ["/bin/sh", "-c", "MYSQL_PWD=\"$MYSQL_ROOT_PASSWORD\" exec mysql -h 127.0.0.1 -uroot -e 'SELECT 1'"],
      "readyTimeoutS": 120,
      "connection": "Server=127.0.0.1;Port={port};User=root;Password={password}",
      "adminDatabase": "mysql"
    },
    {
      "id": "mariadb",
      "recipe": true,
      "packagePatterns": [],
      "image": "mariadb",
      "composeRepos": ["mariadb"],
      "defaultTag": "lts",
      "port": 3306,
      "memoryMb": 1024,
      "needsEula": false,
      "archs": ["amd64", "arm64"],
      "pullSizeHintMb": 400,
      "passwordEnv": "MARIADB_ROOT_PASSWORD",
      "env": ["MARIADB_ROOT_PASSWORD={password}"],
      "exec": ["/bin/sh", "-c", "MYSQL_PWD=\"$MARIADB_ROOT_PASSWORD\" exec mariadb -h 127.0.0.1 -uroot -e 'SELECT 1'"],
      "readyTimeoutS": 90,
      "connection": "Server=127.0.0.1;Port={port};User=root;Password={password}",
      "adminDatabase": "mysql"
    },
    {
      "id": "oracle",
      "recipe": true,
      "packagePatterns": ["oracle.entityframeworkcore"],
      "image": "gvenzl/oracle-free",
      "composeRepos": ["gvenzl/oracle-free"],
      "defaultTag": "23-slim",
      "port": 1521,
      "memoryMb": 2048,
      "needsEula": false,
      "archs": ["amd64", "arm64"],
      "pullSizeHintMb": 1200,
      "passwordEnv": "ORACLE_PASSWORD",
      "env": ["ORACLE_PASSWORD={password}"],
      "exec": ["/bin/sh", "-c", "sqlplus -L -S /nolog <<EOF | grep -q DTTREADY\nCONNECT system/${ORACLE_PASSWORD}@127.0.0.1:1521/FREEPDB1\nSET HEADING OFF FEEDBACK OFF\nSELECT 'DTT'||'READY' FROM dual;\nEXIT\nEOF\n"],
      "readyTimeoutS": 300,
      "connection": "User Id=system;Password={password};Data Source=127.0.0.1:{port}/FREEPDB1",
      "adminDatabase": "FREEPDB1"
    },
    {
      "id": "firebird",
      "recipe": false,
      "packagePatterns": ["firebirdsql.entityframeworkcore.firebird", "entityframeworkcore.firebird"],
      "message": "Firebird is recognised but has no throw-away Docker recipe yet."
    },
    {
      "id": "db2",
      "recipe": false,
      "packagePatterns": ["ibm.entityframeworkcore"],
      "message": "Db2 is recognised but has no throw-away Docker recipe yet."
    },
    {
      "id": "cosmos",
      "recipe": false,
      "packagePatterns": ["microsoft.entityframeworkcore.cosmos"],
      "message": "Cosmos DB is recognised but has no throw-away Docker recipe yet."
    }
  ]
}
